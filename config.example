# config.example — the shape of ~/.claude-pr-bot/.env on the box.
#
# You do NOT copy this file anywhere. `bootstrap.sh` creates the real .env, prompts for the
# two per-person values, and only ever ADDS missing keys — so your edits survive a re-run.
# This file exists so you can see every knob in one place before you start.
#
# The real file is chmod 600 and lives outside the rsync target, so `pnpm staging:dev`
# cannot delete it and it never reaches a git repo.
#
# Per-person data (each teammate's encrypted PAT + Slack member ID) is NOT here — it is in
# ~/.claude-pr-bot/users.json, written by the dashboard when they sign in.

# --- secrets you paste in yourself (bootstrap leaves them empty) ------------------------------

# A GitHub classic PAT with `repo` scope, belonging to YOU. Every comment, review and
# approval the dashboard posts is attributed to this account — that is the whole design.
# Do not add `read:org`: the only call that needed it was `gh pr view --json reviewRequests`,
# which resolves through GraphQL. The REST endpoints carry the same data under `repo` alone.
GITHUB_PAT=

# A Slack incoming webhook. Point it at a private, single-member channel — the cards name
# PR titles and authors. Leave empty to run without Slack; the dashboard still works.
SLACK_WEBHOOK=

# --- per-person values (bootstrap prompts for these on first run) -----------------------------

# Your GitHub login. Must match the account the PAT belongs to.
REVIEWER=

# Your staging environment slug: your branch name minus the `-staging` suffix.
# Branch `asela-staging` => `asela`. PUBLIC_URL and the Apache vhost hostname both derive
# from this, so there is one value to get right instead of two that can drift apart.
PRBOT_ENV=

# --- GitHub login (one-click sign-in instead of pasting a token) -------------------------------

# Create an OAuth App (github.com/settings/developers) or a GitHub App, with callback URL
#   https://prbot-<env>.staging.eng.cutanddry.com/prbot/oauth/callback
# and paste its client ID + secret here. Leave empty and the login page offers token
# sign-in only. Restart prbot after changing.
GH_CLIENT_ID=
GH_CLIENT_SECRET=
# OAuth App: set to `repo` (tokens act as the user; tick "Expire user access tokens" when
# creating the app and they last 8 hours, refreshed here automatically). GitHub App: leave
# EMPTY — permissions come from the app instead of a scope.
GH_OAUTH_SCOPES=

# --- defaults that are usually right ----------------------------------------------------------

REPO=GetCodifyAI/cut-and-dry
PRBOT_DOMAIN=staging.eng.cutanddry.com

# Auto-generated by bootstrap. Signs every dashboard link. Rotating it invalidates
# outstanding Slack buttons, which is the correct move if a link ever leaks.
PRBOT_SECRET=

# 1 = the dashboard renders and the buttons work, but nothing is ever written to GitHub.
# Ships as 1 on purpose. Flip to 0 only after a dry run you have compared by hand, and
# restart the endpoint afterwards — it reads this file once, at startup.
DRY_RUN=1

# 1 skips PRs opened by bots. Default 0: AI-written PRs are where a skeptical review pays
# off most, and they are the bulk of the queue.
SKIP_BOT_PRS=0

# Refuse to start a review below this much available RAM, in MB.
MIN_FREE_MB=800
